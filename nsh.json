{
  "name": "Mojiang",
  "id": "com.huacnlee.mahjong",
  "version": "1.1.0",
  "build": 4,
  "theme": "theme.json",
  "window": {
    "title": "Mojiang",
    "defaultSize": {
      "width": 1280,
      "height": 860
    },
    "minSize": {
      "width": 1080,
      "height": 760
    },
    "titleBar": {
      "style": "hidden",
      "height": 48,
      "controlsOffset": {
        "x": 20,
        "y": 17
      }
    }
  },
  "icon": {
    "macos": "assets/icon-macos.png",
    "ios": "assets/icon.png",
    "android": "assets/icon.png",
    "windows": "assets/icon.png",
    "linux": "assets/icon.png",
    "web": "assets/icon.png"
  },
  "ios": {
    "infoPlist": {
      "UISupportedInterfaceOrientations": [
        "UIInterfaceOrientationLandscapeLeft",
        "UIInterfaceOrientationLandscapeRight"
      ],
      "UISupportedInterfaceOrientations~ipad": [
        "UIInterfaceOrientationLandscapeLeft",
        "UIInterfaceOrientationLandscapeRight"
      ],
      "UIRequiresFullScreen": true,
      "ITSAppUsesNonExemptEncryption": false
    }
  },
  "updater": {
    "github": "huacnlee/mahjong",
    "publicKey": "IeEVf1SX+Vdh0oKqcSEIcrBsN2av5+URTydgdGMZTz4="
  }
}
